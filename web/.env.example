# RecordsWeb Web — Supabase client configuration
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY

# Never expose SUPABASE_SERVICE_ROLE_KEY or another server-side secret here.
# RecordsWeb's browser bundle is public, so only VITE_ variables safe for the client belong in this file.

# Website update control. "stable" lets the web app share the same release row
# as the desktop application. Use "web" if you later want independent web releases.
VITE_RECORDSWEB_RELEASE_CHANNEL=stable

# How often an open RecordsWeb tab checks Supabase for a newer active release.
# Minimum enforced by the app: 30 seconds.
VITE_RECORDSWEB_UPDATE_CHECK_SECONDS=60

# Countdown before a safe automatic refresh. The countdown pauses while the
# user has unsaved consultation/form work open.
VITE_RECORDSWEB_UPDATE_GRACE_SECONDS=120
