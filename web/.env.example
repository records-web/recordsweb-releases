VITE_RECORDSWEB_GAME_API_URL=https://api.recordsweb.org
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Server-side only — configure in Vercel Project Settings > Environment Variables
# Never prefix passwords or the service-role key with VITE_.
# ---------------------------------------------------------------------------

# Mailer 1: public contact form
IONOS_CONTACT_SMTP_USER=contactus@recordsweb.org
IONOS_CONTACT_SMTP_PASSWORD=your-contact-mailbox-password
CONTACT_TO=contactus@recordsweb.org

# Mailer 2: deployment request received / approved / declined emails
IONOS_NOREPLY_SMTP_USER=noreply@recordsweb.org
IONOS_NOREPLY_SMTP_PASSWORD=your-noreply-mailbox-password
IONOS_NOREPLY_SMTP_HOST=smtp.ionos.co.uk
IONOS_NOREPLY_SMTP_PORT=465
RECORDSWEB_SUPPORT_EMAIL=contactus@recordsweb.org

# Required by the server-side request email endpoints.
SUPABASE_URL=https://cdakocrmfstsknbgugkc.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Legacy contact-mailer fallbacks are still supported by api/contact.js:
# IONOS_SMTP_USER=contactus@recordsweb.org
# IONOS_SMTP_PASSWORD=...

# Stripe billing is server-side in Supabase Edge Functions.
# Set these with `supabase secrets set`; do NOT prefix them with VITE_:
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# RECORDSWEB_PUBLIC_URL=https://recordsweb.org

# Discord / RecordsWeb Bot is server-side only in Supabase Edge Functions.
# Configure with `supabase secrets set` — NEVER expose the bot token to Vite/Vercel client code:
# RECORDSWEB_DISCORD_BOT_TOKEN=...
# RECORDSWEB_DISCORD_CLIENT_ID=...
# RECORDSWEB_PUBLIC_URL=https://www.recordsweb.org
