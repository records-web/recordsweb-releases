VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-side only. Configure these in Vercel Project Settings > Environment Variables.
# Do NOT prefix these with VITE_ and do not expose them to frontend code.
IONOS_SMTP_USER=contactus@recordsweb.org
IONOS_SMTP_PASSWORD=your-ionos-mailbox-password
CONTACT_TO=contactus@recordsweb.org

# Stripe billing is server-side in Supabase Edge Functions.
# Set these with `supabase secrets set`; do NOT prefix them with VITE_:
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# RECORDSWEB_PUBLIC_URL=https://recordsweb.org
